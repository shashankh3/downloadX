{
  "manifest_version": 3,
  "name": "downloadX Connector",
  "version": "1.5.0",
  "description": "Send links, media and browser downloads to downloadX (localhost).",
  "permissions": ["contextMenus", "downloads", "cookies", "storage", "activeTab", "nativeMessaging", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "downloadX — click to toggle download interception (ON by default)" },
  "commands": {
    "toggle-intercept": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn downloadX interception on or off"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
